{
  "name": "agentic-bot-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run lint:types && bun run format:check && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "cf": "^1.0.0-beta.20",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4"
}
